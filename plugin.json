{
  "schema": 1,
  "id": "pinshot",
  "name": "DX PinShot",
  "version": "0.2.0",
  "description": "Minimalist DX Set-of-Mark screenshot annotator with Alt+Click grouped pins & TUI settings.",
  "author": "DX PinShot contributors",
  "source": "local:dx-pinshot",
  "license": "MIT",
  "requires": {
    "remote_helper": ">=1.3,<2",
    "python": ">=3.10"
  },
  "entrypoints": {
    "cli": {
      "module": "dex_plugin.py",
      "function": "register_cli"
    }
  },
  "dependencies": {},
  "permissions": [
    "local.process",
    "local.files.read",
    "local.files.write",
    "x-clipboard",
    "x-screen-capture"
  ],
  "commands": []
}
